@model PortalKibica.Models.News

@{
    ViewData["Title"] = "Dodaj News";
}

<div class="container mt-4">
    <h2>Dodaj News</h2>
    <hr />

    <form action="/Admin/News/Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="Title" class="form-label">Tytuł</label>
            <input type="text" id="Title" name="Title" class="form-control" placeholder="Wpisz tytuł newsa" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="8" id="newsContent"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
            <div class="form-text text-end" id="charCount">0 znaków</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Zdjęcie (opcjonalne)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <button type="submit" class="btn btn-success">Zapisz</button>
        <a href="/Admin/News" class="btn btn-secondary">Anuluj</a>
    </form>
</div>

@section Scripts {
    <script>
        const newsContent = document.getElementById("newsContent");
        const charCount = document.getElementById("charCount");

        function updateCharCount() {
            charCount.textContent = newsContent.value.length + " znaków";
        }

        newsContent.addEventListener("input", updateCharCount);
        updateCharCount();
    </script>
}