@model PortalKibica.Models.News

@{
    ViewData["Title"] = "Usuń News";
}

<div class="container mt-4">
    <h2>Usuń News</h2>
    <hr />

    <div class="alert alert-danger">
        Czy na pewno chcesz usunąć ten news?
    </div>

    <dl class="row">
        <dt class="col-sm-2">Tytuł</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.PublishDate.ToString("dd.MM.yyyy HH:mm")</dd>
    </dl>

    <form action="/Admin/News/Delete/@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Tak, usuń</button>
        <a href="/Admin/News" class="btn btn-secondary">Anuluj</a>
    </form>
</div>