@model PortalKibica.Models.Match

@{
    ViewData["Title"] = "Usuń Mecz";
}

<div class="container mt-4">
    <h2>🗑️ Usuń Mecz</h2>
    <hr />

    <div class="alert alert-danger">
        Czy na pewno chcesz usunąć ten mecz?
    </div>

    <dl class="row">
        <dt class="col-sm-2">Rywal</dt>
        <dd class="col-sm-10">@Model.Opponent</dd>

        <dt class="col-sm-2">Data</dt>
        <dd class="col-sm-10">@Model.MatchDate.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-2">Stadion</dt>
        <dd class="col-sm-10">@Model.Stadium</dd>
    </dl>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">🗑️ Tak, usuń</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>