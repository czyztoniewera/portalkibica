@model PortalKibica.Models.Player

@{
    ViewData["Title"] = "Usuń Zawodnika";
}

<div class="container mt-4">
    <h2>Usuń Zawodnika</h2>
    <hr />

    <div class="alert alert-danger">
        Czy na pewno chcesz usunąć tego zawodnika?
    </div>

    <dl class="row">
        <dt class="col-sm-2">Imię i nazwisko</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Pozycja</dt>
        <dd class="col-sm-10">@Model.Position</dd>

        <dt class="col-sm-2">Numer</dt>
        <dd class="col-sm-10">@Model.Number</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Tak, usuń</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>