@model IEnumerable<PortalKibica.Models.Player>

@{
    ViewData["Title"] = "Zawodnicy";
    var allPositions = ViewData["AllPositions"] as List<string> ?? new List<string>();
    var selectedPosition = ViewData["SelectedPosition"] as string;
}

<h2 class="page-title">Skład zespołu</h2>
<div class="stripe-bar">
    <span class="stripe-blue"></span>
    <span class="stripe-white"></span>
    <span class="stripe-red"></span>
</div>

<div class="position-filter mb-4">
    <a asp-action="Index" class="btn btn-sm @(selectedPosition == null ? "btn-primary" : "btn-outline-primary")">Wszyscy</a>
    @foreach (var pos in allPositions)
    {
        <a asp-action="Index" asp-route-position="@pos" class="btn btn-sm @(selectedPosition == pos ? "btn-primary" : "btn-outline-primary")">@pos</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Brak zawodników do wyświetlenia.</div>
}
else
{
    @foreach (var group in Model.GroupBy(p => p.Position))
    {
        <h4 class="position-group-title">@group.Key</h4>
        <div class="row mb-4">
            @foreach (var item in group)
            {
                <div class="col-md-3 mb-4">
                    <div class="card card-hover h-100 text-center">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" class="card-img-top" style="height:220px; object-fit:cover;" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height:220px;">
                                Brak zdjęcia
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title mb-1">@item.Name</h5>
                            <p class="card-text text-muted mb-1">@item.Position</p>
                            <span class="badge bg-danger fs-6">#@item.Number</span>
                            <div class="mt-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Zobacz profil</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}