@model PortalKibica.Models.Player

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-secondary mb-3">← Powrót do składu</a>

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="img-fluid rounded" alt="@Model.Name" />
            }
            else
            {
                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height:300px;">
                    Brak zdjęcia
                </div>
            }
        </div>
        <div class="col-md-8">
            <h2>@Model.Name</h2>
            <p class="fs-5"><span class="badge bg-danger">#@Model.Number</span> &nbsp; @Model.Position</p>
            <hr />
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p style="white-space: pre-line;">@Model.Description</p>
            }
            else
            {
                <p class="text-muted">Brak dodatkowych informacji.</p>
            }
        </div>
    </div>
</div>