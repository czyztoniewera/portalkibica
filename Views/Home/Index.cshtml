@{
    ViewData["Title"] = "Strona główna";
    var nextMatch = ViewData["NextMatch"] as PortalKibica.Models.Match;
    var latestNews = ViewData["LatestNews"] as List<PortalKibica.Models.News>;
}

<div class="text-center mb-5">
    <h1 class="display-4">⚪🔴 Witamy w Portalu Kibica Wisły Kraków</h1>
    <p class="lead">Najświeższe newsy, skład zespołu i terminarz meczów w jednym miejscu.</p>
</div>

@if (nextMatch != null)
{
    <div class="card border-danger mb-5 mx-auto" style="max-width: 600px;">
        <div class="card-body text-center">
            <h4 class="card-title">⏳ Najbliższy mecz</h4>
            <h3 class="mb-2">Wisła Kraków vs @nextMatch.Opponent</h3>
            <p class="mb-1">📍 @nextMatch.Stadium</p>
            <p class="text-muted">🕒 @nextMatch.MatchDate.ToString("dd.MM.yyyy HH:mm")</p>
            <a asp-controller="Matches" asp-action="Index" class="btn btn-outline-danger mt-2">Zobacz terminarz</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center mx-auto" style="max-width: 600px;">
        Brak zaplanowanych meczów.
        <a asp-controller="Matches" asp-action="Index" class="btn btn-sm btn-outline-primary ms-2">Terminarz</a>
    </div>
}

<h2 class="mb-4">📰 Najnowsze aktualności</h2>

@if (latestNews == null || !latestNews.Any())
{
    <div class="alert alert-info">Brak newsów do wyświetlenia.</div>
}
else
{
    <div class="row mb-4">
        @foreach (var item in latestNews)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" class="card-img-top" style="height:180px; object-fit:cover;" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted small">@item.PublishDate.ToString("dd.MM.yyyy HH:mm")</p>
                        <a asp-controller="News" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-auto">Czytaj więcej</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center">
        <a asp-controller="News" asp-action="Index" class="btn btn-primary">Zobacz wszystkie newsy</a>
    </div>
}