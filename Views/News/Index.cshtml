@model IEnumerable<PortalKibica.Models.News>

@{
    ViewData["Title"] = "Aktualności";
}

<h2 class="page-title">Aktualności</h2>
<div class="stripe-bar">
    <span class="stripe-blue"></span>
    <span class="stripe-white"></span>
    <span class="stripe-red"></span>
</div>

<form method="get" asp-action="Index" class="mb-4">
    <div class="input-group" style="max-width: 500px;">
        <input type="text" name="search" class="form-control" placeholder="Szukaj newsów..." value="@ViewData["CurrentSearch"]" />
        <button type="submit" class="btn btn-primary">Szukaj</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Wyczyść</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Brak newsów do wyświetlenia.</div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card card-hover h-100">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;" alt="@item.Title" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted small">@item.PublishDate.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="card-text">
                            @(item.Content.Length > 100 ? item.Content.Substring(0, 100) + "..." : item.Content)
                        </p>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary mt-auto">Czytaj więcej</a>
                    </div>
                </div>
            </div>
        }
    </div>
}