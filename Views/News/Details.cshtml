@model PortalKibica.Models.News

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-secondary mb-3">← Powrót do aktualności</a>

    <h2>@Model.Title</h2>
    <p class="text-muted">@Model.PublishDate.ToString("dd.MM.yyyy HH:mm")</p>
    <hr />

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" class="img-fluid mb-3" style="max-height:400px; object-fit:cover;" alt="@Model.Title" />
    }

    <p style="white-space: pre-line;">@Model.Content</p>
</div>