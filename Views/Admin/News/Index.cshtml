@model IEnumerable<PortalKibica.Models.News>

@{
    ViewData["Title"] = "Zarządzanie Newsami";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📰 Zarządzanie Newsami</h2>
        <a asp-action="Create" class="btn btn-success">+ Dodaj news</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Brak newsów. Dodaj pierwszy!</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Tytuł</th>
                    <th>Data publikacji</th>
                    <th>Zdjęcie</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.PublishDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath" width="60" height="40" style="object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Brak</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">✏️ Edytuj</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Usuń</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>