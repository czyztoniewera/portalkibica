@model IEnumerable<PortalKibica.Models.Player>

@{
    ViewData["Title"] = "Zarządzanie Zawodnikami";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Zarządzanie Zawodnikami</h2>
        <a href="/Admin/Players/Create" class="btn btn-success">+ Dodaj zawodnika</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Brak zawodników. Dodaj pierwszego!</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nr</th>
                    <th>Imię i nazwisko</th>
                    <th>Pozycja</th>
                    <th>Zdjęcie</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Number</td>
                        <td>@item.Name</td>
                        <td>@item.Position</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath" width="50" height="60" style="object-fit:cover;" />
                            }
                            else
                            {
                                <span class="text-muted">Brak</span>
                            }
                        </td>
                        <td>
                            <a href="/Admin/Players/Edit/@item.Id" class="btn btn-sm btn-primary">✏️ Edytuj</a>
                            <a href="/Admin/Players/Delete/@item.Id" class="btn btn-sm btn-danger">🗑️ Usuń</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>