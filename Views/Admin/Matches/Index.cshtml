@model IEnumerable<PortalKibica.Models.Match>

@{
    ViewData["Title"] = "Zarządzanie Meczami";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Zarządzanie Meczami</h2>
        <a asp-action="Create" class="btn btn-success">+ Dodaj mecz</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Brak meczów. Dodaj pierwszy!</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Rywal</th>
                    <th>Data</th>
                    <th>Stadion</th>
                    <th>Wynik</th>
                    <th>Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Opponent</td>
                        <td>@item.MatchDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@item.Stadium</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Result))
                            {
                                <span class="badge bg-dark">@item.Result</span>
                            }
                            else
                            {
                                <span class="text-muted">Brak wyniku</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">✏️ Edytuj</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">🗑️ Usuń</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>